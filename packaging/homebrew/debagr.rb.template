# frozen_string_literal: true

cask "debagr" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/radeknovis/homebrew-debagr/releases/download/v#{version}/Debagr-#{version}-arm64.dmg"
  name "Debagr"
  desc "Remote device deployment through a private VPN"
  homepage "https://radeknovis.github.io/debagr-site/"

  depends_on arch: :arm64
  depends_on macos: ">= :sonoma"

  app "Debagr.app"
  binary "#{appdir}/Debagr.app/Contents/MacOS/Debagr", target: "debagr"

  zap trash: [
    "~/Library/Application Support/Debagr",
    "~/Library/Preferences/dev.debagr.app.plist",
  ]
end
